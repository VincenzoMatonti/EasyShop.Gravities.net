APP_NAME=EasyShop
APP_ENV=production
APP_DEBUG=false

APP_KEY=

APP_URL=

MYSQL_ATTR_SSL_CA=/etc/secrets/tidb-ca.pem


# DATABASE

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=


# LOG

LOG_CHANNEL=stderr
LOG_LEVEL=info


# CACHE / REDIS

CACHE_STORE=redis

REDIS_CACHE_CONNECTION=cache

REDIS_CLIENT=phpredis

REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=
REDIS_USERNAME=
REDIS_SCHEME=tls


# QUEUE

QUEUE_CONNECTION=redis


# MAIL

MAIL_MAILER=resend

RESEND_API_KEY=

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

MAIL_SUPPORT_ADDRESS=
MAIL_SUPPORT_NAME=

MAIL_MARKETING_ADDRESS=
MAIL_MARKETING_NAME=

MAIL_ORDERS_ADDRESS=
MAIL_ORDERS_NAME=

MAIL_BILLING_ADDRESS=
MAIL_BILLING_NAME=


# STORAGE R2

FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_DEFAULT_REGION=auto

AWS_BUCKET=

AWS_ENDPOINT=

AWS_URL=

AWS_USE_PATH_STYLE_ENDPOINT=true